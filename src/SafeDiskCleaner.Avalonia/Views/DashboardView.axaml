<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SafeDiskCleaner.Avalonia.Localization"
             x:Class="SafeDiskCleaner.App.Views.DashboardView">
  <ScrollViewer>
    <StackPanel Margin="24,20,24,28" Spacing="16">

      <!-- STAT CARDS -->
      <Grid ColumnDefinitions="*,*,*,*">
        <Border Classes="NeonCard" Margin="0,0,8,0">
          <StackPanel>
            <TextBlock Text="{loc:Loc Dash.FreedTotal}"
                       Classes="NeonSection" />
            <TextBlock Text="{Binding TotalFreed}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Classes="NeonCard" Grid.Column="1" Margin="8,0,8,0">
          <StackPanel>
            <TextBlock Text="{loc:Loc Dash.TotalOps}"
                       Classes="NeonSection" />
            <TextBlock Text="{Binding TotalCleanedEntries}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,6,0,0" />
          </StackPanel>
        </Border>
        <Border Classes="NeonCard" Grid.Column="2" Margin="8,0,8,0">
          <StackPanel>
            <TextBlock Text="{loc:Loc Nav.Quarantine}"
                       Classes="NeonSection" />
            <TextBlock Text="{Binding QuarantineSize}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource WarningBrush}"
                       Margin="0,6,0,0" />
            <TextBlock Classes="NeonHint"><Run Text="{Binding QuarantineCount}" /><Run Text="{loc:Loc Frag.FilesWord}" /></TextBlock>
          </StackPanel>
        </Border>
        <Border Classes="NeonCard" Grid.Column="3" Margin="8,0,0,0">
          <StackPanel>
            <TextBlock Text="{loc:Loc Dash.LastScan}"
                       Classes="NeonSection" />
            <TextBlock Text="{Binding LastScanPotential}"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,6,0,0" />
            <TextBlock Classes="NeonHint"><Run Text="{Binding LastScanCandidates}" /><Run Text="{loc:Loc Frag.CandidatesWord}" /></TextBlock>
          </StackPanel>
        </Border>
      </Grid>

      <!-- QUICK ACTIONS -->
      <Border Classes="NeonCard">
        <StackPanel>
          <TextBlock Text="{loc:Loc Dash.QuickActions}"
                     Classes="NeonTitle" />
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
            <Button Classes="NeonPrimary"
                    Content="{loc:Loc Dash.ScanNow}"
                    Command="{Binding GoScanNowCommand}" />
            <Button Classes="NeonOutline"
                    Content="{loc:Loc Dup.ResultsTitle}"
                    Command="{Binding GoDuplicatesCommand}" />
            <Button Classes="NeonOutline"
                    Content="{loc:Loc Nav.Quarantine}"
                    Command="{Binding GoQuarantineCommand}" />
            <Button Classes="NeonOutline"
                    Content="Audit Log"
                    Command="{Binding GoAuditCommand}" />
            <Button Classes="NeonOutline"
                    Content="{loc:Loc Nav.Settings}"
                    Command="{Binding GoSettingsCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- FREED HISTORY CHART -->
      <Border Classes="NeonCard">
        <StackPanel>
          <TextBlock Text="{loc:Loc Dash.FreedHistory}"
                     Classes="NeonTitle" />
          <ItemsControl ItemsSource="{Binding FreedHistory}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Width="34" Margin="3,0" VerticalAlignment="Bottom">
                  <Grid Height="72" VerticalAlignment="Bottom">
                    <Rectangle Fill="{DynamicResource AccentBrush}"
                               Opacity="0.8"
                               RadiusX="3" RadiusY="3"
                               VerticalAlignment="Bottom"
                               Height="{Binding HeightPx}">
                      <ToolTip.Tip>
                        <TextBlock Text="{Binding SizeText}" />
                      </ToolTip.Tip>
                    </Rectangle>
                  </Grid>
                  <TextBlock Text="{Binding Label}"
                             FontSize="9"
                             HorizontalAlignment="Center"
                             Margin="0,4,0,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- DRIVES -->
      <Border Classes="NeonCard">
        <StackPanel>
          <TextBlock Text="{loc:Loc Dash.DrivesTitle}"
                     Classes="NeonTitle" />
          <ItemsControl ItemsSource="{Binding Drives}" Margin="0,14,0,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="NeonInfo" Width="230">
                  <StackPanel>
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Text="{Binding Letter}"
                                 FontSize="20"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource AccentBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Kind}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 VerticalAlignment="Center"
                                 Margin="8,0,0,0" />
                    </Grid>
                    <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                      <ProgressBar Maximum="100"
                                   Value="{Binding UsedPercent}"
                                   Classes="NeonProgress"
                                   Height="8" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding UsedPercent, StringFormat={}{0:0}%}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="10,0,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,8,0,0"
                                Spacing="12">
                      <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{loc:Loc Dash.FreePrefix}" />
                        <Run Text="{Binding FreeText}" Foreground="{DynamicResource SuccessBrush}" />
                      </TextBlock>
                      <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="{loc:Loc Frag.TotalPrefix}" />
                        <Run Text="{Binding TotalText}" />
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>