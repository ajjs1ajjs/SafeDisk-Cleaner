<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SafeDiskCleaner.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SafeDiskCleaner/Themes/Base.Dark.axaml" />
        <ResourceInclude Source="avares://SafeDiskCleaner/Themes/Accent.Cyan.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SafeDiskCleaner/Themes/Neon.axaml" />
  </Application.Styles>
</Application>