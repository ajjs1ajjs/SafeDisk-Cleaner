<UserControl x:Class="SafeDiskCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SafeDiskCleaner.App.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28" MaxWidth="760">

            <!-- ===== INTERFACE CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.InterfaceCard}"
                               Style="{StaticResource NeonCardTitle}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.Theme}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsDarkTheme}"
                                      Width="64" Height="28"
                                      Style="{StaticResource NeonToggleSwitch}" />
                    </Grid>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.AccentColor}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource NeonComboBox}"
                                  ItemsSource="{Binding AccentOptions}"
                                  SelectedItem="{Binding AccentPreset}"
                                  VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.Language}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource NeonComboBox}"
                                  ItemsSource="{Binding LanguageOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding Language}"
                                  VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== CLEANING CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.CleaningCard}"
                               Style="{StaticResource NeonCardTitle}" />
                    <Grid Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.RetentionDays}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Width="80"
                                 Style="{StaticResource NeonTextBox}"
                                 Text="{Binding QuarantineRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.AutoThreshold}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Width="80"
                                 Style="{StaticResource NeonTextBox}"
                                 Text="{Binding AutoThreshold, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== EXCLUSIONS CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.ExclusionsCard}"
                               Style="{StaticResource NeonCardTitle}" />
                    <TextBlock Text="{loc:Loc Settings.ExclusionsHint}"
                               FontSize="12"
                               Margin="0,2,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Style="{StaticResource NeonTextBox}"
                             MinHeight="96"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             Text="{Binding ExclusionsText, UpdateSourceTrigger=LostFocus}" />
                </StackPanel>
            </Border>

            <!-- ===== SCHEDULE CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.ScheduleCard}"
                               Style="{StaticResource NeonCardTitle}" />
                    <CheckBox Content="{loc:Loc Settings.ScheduleEnable}"
                              IsChecked="{Binding ScheduleEnabled}"
                              Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc Settings.ScheduleTimeLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBox Width="70"
                                 Style="{StaticResource NeonTextBox}"
                                 Margin="10,0,20,0"
                                 Text="{Binding ScheduleTime, UpdateSourceTrigger=LostFocus}" />
                        <ComboBox Style="{StaticResource NeonComboBox}"
                                  Width="140"
                                  ItemsSource="{Binding FrequencyOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding ScheduleFrequency}"
                                  VerticalAlignment="Center" />
                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="{loc:Loc Common.Continue}"
                                Margin="16,0,0,0"
                                Command="{Binding ApplyScheduleCommand}" />
                        <TextBlock Text="{Binding ScheduleStatus}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== PROGRAM CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Settings.ProgramCard}"
                               Style="{StaticResource NeonCardTitle}" />
                    <Grid Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.Version}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                    </Grid>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Settings.DataDir}" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding DataRoot}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Top" />
                            <materialDesign:PackIcon Kind="Folder"
                                                     Width="14" Height="14"
                                                     Margin="8,2,0,0"
                                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource NeonPrimaryButton}"
                                Content="{loc:Loc Settings.CheckUpdates}"
                                Command="{Binding CheckUpdateCommand}" />
                        <TextBlock Text="{Binding UpdateText}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
