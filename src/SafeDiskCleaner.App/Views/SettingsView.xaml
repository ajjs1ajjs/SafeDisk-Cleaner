<UserControl x:Class="SafeDiskCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28" MaxWidth="760">

            <!-- ===== INTERFACE CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="Інтерфейс"
                               Style="{StaticResource NeonCardTitle}" />
                    <CheckBox Style="{StaticResource NeonCheckBox}"
                              Content="Темна тема"
                              IsChecked="{Binding IsDarkTheme}" />
                </StackPanel>
            </Border>

            <!-- ===== CLEANING CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="Очищення"
                               Style="{StaticResource NeonCardTitle}" />
                    <Grid Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Термін зберігання карантину (днів):"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Width="80"
                                 Style="{StaticResource NeonTextBox}"
                                 Text="{Binding QuarantineRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Auto-поріг впевненості (%):"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" />
                        <TextBox Grid.Column="1"
                                 Width="80"
                                 Style="{StaticResource NeonTextBox}"
                                 Text="{Binding AutoThreshold, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== PROGRAM CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="Програма"
                               Style="{StaticResource NeonCardTitle}" />
                    <Grid Margin="0,8,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Версія:" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                    </Grid>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Каталог даних:" VerticalAlignment="Top"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding DataRoot}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Top" />
                            <materialDesign:PackIcon Kind="Folder"
                                                     Width="14" Height="14"
                                                     Margin="8,2,0,0"
                                                     Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource NeonPrimaryButton}"
                                Content="Перевірити оновлення"
                                Command="{Binding CheckUpdateCommand}" />
                        <TextBlock Text="{Binding UpdateText}"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
