<UserControl x:Class="SafeDiskCleaner.App.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SafeDiskCleaner.App.Localization"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SafeDiskCleaner.App">
    <UserControl.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <converters:BytesToHumanSizeConverter x:Key="BytesToHuman" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28">

            <!-- ===== AUDIT LOG INFO CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Audit Log"
                                   Style="{StaticResource NeonCardTitle}" />
                        <TextBlock FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="{loc:Loc Audit.Description}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource NeonDangerButton}"
                            Content="{loc:Loc Audit.ClearLog}"
                            VerticalAlignment="Center"
                            Command="{Binding ClearCommand}" />
                </Grid>
            </Border>

            <!-- ===== MESSAGE ===== -->
            <Border Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"
                    Style="{StaticResource NeonInfoBorder}"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <!-- ===== AUDIT TABLE ===== -->
            <Border Style="{StaticResource NeonCard}" Padding="0">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel Margin="32,48"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon Kind="TextBoxSearchOutline"
                                                 Width="48" Height="48"
                                                 HorizontalAlignment="Center"
                                                 Foreground="{StaticResource NeonCyanBrush}"
                                                 Opacity="0.8" />
                        <TextBlock Text="{loc:Loc Audit.EmptyTitle}"
                                   FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{loc:Loc Audit.EmptyText}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Entries}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="600"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBool}}"
                              Style="{StaticResource NeonDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Common.Date}" Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150" />
                            <DataGridTextColumn Header="{loc:Loc Common.Action}" Binding="{Binding Action}" Width="130" />
                            <DataGridTextColumn Header="{loc:Loc Common.Size}" Binding="{Binding Size, Converter={StaticResource BytesToHuman}}" Width="100" />
                            <DataGridTextColumn Header="{loc:Loc Common.Path}" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Common.Details}" Binding="{Binding Detail}" Width="200" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
