<UserControl x:Class="SafeDiskCleaner.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SafeDiskCleaner.App"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="Root">
    <UserControl.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:RiskToBrushConverter x:Key="RiskToBrush" />
        <converters:ConfidenceToBrushConverter x:Key="ConfidenceToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,24">

            <!-- Scan options card -->
            <Border Style="{StaticResource MaterialDesignCard}"
                    Padding="20,16"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Область аналізу"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="0,0,8,8"
                                        Command="{Binding DataContext.ToggleDriveCommand, ElementName=Root}"
                                        CommandParameter="{Binding Letter}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Harddisk"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,8,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.7" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 materialDesign:HintAssist.Hint="Додаткові шляхи для аналізу (через кому)..."
                                 Text="{Binding CustomRoots, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Огляд..."
                                Margin="8,0,0,0"
                                Command="{Binding PickFoldersCommand}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox Content="Medium (оновлення, пакети)"
                                  IsChecked="{Binding IncludeMedium}"
                                  Margin="0,0,24,0" />
                        <CheckBox Content="Advanced (DriverStore, Windows.old)"
                                  IsChecked="{Binding IncludeAdvanced}"
                                  Margin="0,0,24,0" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Min confidence:" VerticalAlignment="Center" />
                            <TextBox Width="56"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding MinConfidence, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Не використано днів:" VerticalAlignment="Center" />
                            <TextBox Width="56"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding RecencyDays, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Command="{Binding ScanCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Content" Value="Аналізувати" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Content" Value="Сканування..." />
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Скасувати"
                                Margin="8,0,0,0"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <StackPanel Visibility="{Binding ScanProgress, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding ScanProgress.Percent, Mode=OneWay}"
                             Maximum="100"
                             Style="{StaticResource MaterialDesignLinearProgressBar}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Opacity="0.8">
                    <Run Text="{Binding ScanProgress.FilesScanned, Mode=OneWay, StringFormat={}{0:N0}}" />
                    <Run Text=" файлів · " />
                    <Run Text="{Binding ScanProgress.CandidatesFound, Mode=OneWay}" />
                    <Run Text=" кандидатів" />
                </TextBlock>
            </StackPanel>

            <!-- Cleanup progress -->
            <StackPanel Visibility="{Binding CleanupProgress, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding CleanupProgress.Percent, Mode=OneWay}"
                             Maximum="100"
                             Style="{StaticResource MaterialDesignLinearProgressBar}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           Text="{Binding CleanupProgress.CurrentPath, Mode=OneWay}" />
            </StackPanel>

            <!-- Message -->
            <Border Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="13" />
            </Border>

            <!-- Summary -->
            <StackPanel Visibility="{Binding ScanResult, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding ScanResult.Summary.TotalPotential, StringFormat={}{0:N0}}" />
                        <TextBlock Text="Потенційно звільниться (B)" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding ScanResult.Summary.ScannedFiles, StringFormat={}{0:N0}}" />
                        <TextBlock Text="Файлів проскановано" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding ScanResult.Candidates.Count}" />
                        <TextBlock Text="Кандидатів" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding ScanResult.Summary.ElapsedMs, StringFormat={}{0} ms}" />
                        <TextBlock Text="Час аналізу" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Candidates -->
            <Border Style="{StaticResource MaterialDesignCard}"
                    Padding="0"
                    Margin="0,0,0,16"
                    Visibility="{Binding ScanResult, Converter={StaticResource NullToCollapsed}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Кандидати" Margin="0,0,16,0" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                    <Run Text=" вибрано · " />
                                    <Run Text="{Binding SelectedSize, Mode=OneWay, StringFormat={}{0:N0}}" />
                                    <Run Text=" B" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Вибрати все"
                                        Command="{Binding ToggleAllSelectionCommand}">
                                    <Button.CommandParameter>
                                        <sys:Boolean>True</sys:Boolean>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}"
                                        Content="Зняти"
                                        Command="{Binding ToggleAllSelectionCommand}">
                                    <Button.CommandParameter>
                                        <sys:Boolean>False</sys:Boolean>
                                    </Button.CommandParameter>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="Dry Run"
                                        Margin="8,0,0,0"
                                        Command="{Binding CleanCommand}"
                                        CommandParameter="dry-run" />
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Content="Авто-очищення"
                                        Margin="8,0,0,0"
                                        Command="{Binding CleanCommand}"
                                        CommandParameter="auto" />
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Content="Очистити вибране"
                                        Margin="8,0,0,0"
                                        Command="{Binding CleanCommand}"
                                        CommandParameter="interactive" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Candidates}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              MaxHeight="480"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header=""
                                                    IsReadOnly="False"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Шлях" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryLabel}" Width="160" />
                            <DataGridTextColumn Header="Розмір" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="Останній доступ" Binding="{Binding LastAccessText}" Width="110" />
                            <DataGridTemplateColumn Header="Confidence" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Background="{Binding Confidence, Converter={StaticResource ConfidenceToBrush}}"
                                                ToolTip="{Binding Recommendation}">
                                            <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}" FontSize="12" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Рекомендація" Binding="{Binding Recommendation}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Cleanup result -->
            <Border Style="{StaticResource MaterialDesignCard}"
                    Padding="0"
                    Margin="0,0,0,16"
                    Visibility="{Binding CleanupResult, Converter={StaticResource NullToCollapsed}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Результат очищення" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CleanupResult.Entries}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="360"
                              Style="{StaticResource MaterialDesignDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Шлях" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Розмір" Binding="{Binding Size}" Width="90" />
                            <DataGridTextColumn Header="Деталі" Binding="{Binding Detail}" Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
