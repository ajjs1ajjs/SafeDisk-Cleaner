<UserControl x:Class="SafeDiskCleaner.App.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:SafeDiskCleaner.App"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="Root">
    <UserControl.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:RiskToBrushConverter x:Key="RiskToBrush" />
        <converters:ConfidenceToBrushConverter x:Key="ConfidenceToBrush" />
        <converters:BytesToHumanSizeConverter x:Key="BytesToHuman" />
        <converters:DriveIsSelectedConverter x:Key="DriveIsSelected" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28">

            <!-- ===== ANALYSIS AREA CARD ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="Область аналізу"
                               Style="{StaticResource NeonCardTitle}" />

                    <!-- Drive cards -->
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,12,12"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.ToggleDriveCommand, ElementName=Root}"
                                        CommandParameter="{Binding Letter}">
                                    <Button.ToolTip>
                                        <TextBlock>
                                            <Run Text="{Binding Letter}" />
                                            <Run Text=" — " />
                                            <Run Text="{Binding Kind}" />
                                            <Run Text=" · вільно " />
                                            <Run Text="{Binding Free, Converter={StaticResource BytesToHuman}}" />
                                        </TextBlock>
                                    </Button.ToolTip>
                                    <Border x:Name="driveBorder"
                                            Width="110" Height="100"
                                            CornerRadius="12"
                                            Background="{DynamicResource BgCardBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1.5"
                                            Effect="{DynamicResource SoftNeonGlow}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Letter}"
                                                       FontSize="28" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource NeonCyanBrush}"
                                                       Effect="{DynamicResource NeonCyanGlow}" />
                                            <TextBlock Text="{Binding Kind}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <DataTemplate.Triggers>
                                    <!-- Selected drive - bright neon cyan border + glow -->
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource DriveIsSelected}">
                                                <Binding Path="Letter" />
                                                <Binding Path="DataContext.CustomRoots" ElementName="Root" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="driveBorder" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
                                        <Setter TargetName="driveBorder" Property="BorderThickness" Value="2" />
                                        <Setter TargetName="driveBorder" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource BgDeepColor}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="driveBorder" Property="Effect" Value="{DynamicResource NeonCyanGlow}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Custom roots input -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource NeonTextBox}"
                                 materialDesign:HintAssist.Hint="Додаткові шляхи для аналізу (через кому)..."
                                 Text="{Binding CustomRoots, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Style="{StaticResource NeonOutlineButton}"
                                Content="Огляд..."
                                Margin="8,0,0,0"
                                Command="{Binding PickFoldersCommand}" />
                    </Grid>

                    <!-- Scan options row -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox Style="{StaticResource NeonCheckBox}"
                                  Content="Medium (оновлення, пакети)"
                                  IsChecked="{Binding IncludeMedium}" />
                        <CheckBox Style="{StaticResource NeonCheckBox}"
                                  Content="Advanced (DriverStore, Windows.old)"
                                  IsChecked="{Binding IncludeAdvanced}" />
                        <CheckBox Style="{StaticResource NeonCheckBox}"
                                  Content="У кошик"
                                  ToolTip="Малі файли переміщуються в кошик Windows замість остаточного видалення. Великі файли завжди йдуть у карантин."
                                  IsChecked="{Binding MoveToRecycleBin}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Min confidence:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                            <TextBox Width="56"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource NeonTextBox}"
                                     Text="{Binding MinConfidence, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Не використано днів:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                            <TextBox Width="56"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource NeonTextBox}"
                                     Text="{Binding RecencyDays, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Command="{Binding ScanCommand}">
                            <Button.Content>
                                <TextBlock Text="Аналізувати" />
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NeonPrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <TextBlock Text="Сканування..." />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="Скасувати"
                                Margin="12,0,0,0"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="Очистити кошик"
                                Margin="12,0,0,0"
                                ToolTip="Назавжди видалити всі файли з кошика Windows"
                                Command="{Binding EmptyRecycleBinCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== SCAN PROGRESS ===== -->
            <StackPanel Visibility="{Binding ScanProgress, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding ScanProgress.Percent, Mode=OneWay}"
                             Maximum="100"
                             Style="{StaticResource NeonProgressBar}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding ScanProgress.FilesScanned, Mode=OneWay, StringFormat={}{0:N0}}" />
                    <Run Text=" файлів · " />
                    <Run Text="{Binding ScanProgress.CandidatesFound, Mode=OneWay}" />
                    <Run Text=" кандидатів" />
                </TextBlock>
            </StackPanel>

            <!-- ===== CLEANUP PROGRESS ===== -->
            <StackPanel Visibility="{Binding CleanupProgress, Converter={StaticResource NullToCollapsed}}" Margin="0,0,0,16">
                <ProgressBar Value="{Binding CleanupProgress.Percent, Mode=OneWay}"
                             Maximum="100"
                             Style="{StaticResource NeonProgressBar}" />
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding CleanupProgress.CurrentPath, Mode=OneWay}" />
            </StackPanel>

            <!-- ===== MESSAGE ===== -->
            <Border Visibility="{Binding Message, Converter={StaticResource NullToCollapsed}}"
                    Style="{StaticResource NeonInfoBorder}"
                    Margin="0,0,0,16">
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <!-- ===== SUMMARY ===== -->
            <Border Visibility="{Binding ScanResult, Converter={StaticResource NullToCollapsed}}"
                    Style="{StaticResource NeonCard}"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeonCyanBrush}"
                                   Text="{Binding ScanResult.Summary.TotalPotential, Converter={StaticResource BytesToHuman}}"
                                   Effect="{DynamicResource TextGlow}" />
                        <TextBlock Text="Потенційно звільниться" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ScanResult.Summary.ScannedFiles, StringFormat={}{0:N0}}" />
                        <TextBlock Text="Файлів проскановано" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ScanResult.Candidates.Count}" />
                        <TextBlock Text="Кандидатів" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ScanResult.Summary.ElapsedMs, StringFormat={}{0} ms}" />
                        <TextBlock Text="Час аналізу" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== CANDIDATES TABLE ===== -->
            <Border Visibility="{Binding ScanResult, Converter={StaticResource NullToCollapsed}}"
                    Style="{StaticResource NeonCard}"
                    Padding="0"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12"
                            Background="{DynamicResource BgCardBrush}"
                            CornerRadius="12,12,0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource NeonCyanBrush}"
                                               Text="Кандидати" Margin="0,0,16,0"
                                               Effect="{DynamicResource TextGlow}" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                                        <Run Text=" вибрано · " />
                                        <Run Text="{Binding SelectedSize, Mode=OneWay, Converter={StaticResource BytesToHuman}}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource NeonFlatButton}"
                                            Content="Вибрати все"
                                            Command="{Binding ToggleAllSelectionCommand}">
                                        <Button.CommandParameter>
                                            <sys:Boolean>True</sys:Boolean>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Style="{StaticResource NeonFlatButton}"
                                            Content="Зняти"
                                            Command="{Binding ToggleAllSelectionCommand}">
                                        <Button.CommandParameter>
                                            <sys:Boolean>False</sys:Boolean>
                                        </Button.CommandParameter>
                                    </Button>
                                    <Button Style="{StaticResource NeonFlatButton}"
                                            Content="Тільки безпечні"
                                            ToolTip="Вибрати лише кандидатів із рівнем ризику Safe"
                                            Command="{Binding SelectOnlySafeCommand}" />
                                    <Button Style="{StaticResource NeonOutlineButton}"
                                            Content="Експорт CSV"
                                            Margin="4,0,0,0"
                                            ToolTip="Зберегти звіт про кандидатів у файл CSV"
                                            Command="{Binding ExportCommand}" />
                                    <Button Style="{StaticResource NeonOutlineButton}"
                                            Content="Dry Run"
                                            Margin="4,0,0,0"
                                            Command="{Binding CleanCommand}"
                                            CommandParameter="dry-run" />
                                    <Button Style="{StaticResource NeonOutlineButton}"
                                            Content="Авто-очищення"
                                            Margin="4,0,0,0"
                                            Command="{Binding CleanCommand}"
                                            CommandParameter="auto" />
                                    <Button Style="{StaticResource NeonPrimaryButton}"
                                            Content="Очистити вибране"
                                            Margin="8,0,0,0"
                                            Command="{Binding CleanCommand}"
                                            CommandParameter="interactive" />
                                </StackPanel>
                            </Grid>

                            <!-- FILTER BAR -->
                            <Grid Grid.Row="1" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <materialDesign:PackIcon Kind="FilterVariant" Width="16" Height="16" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Фільтри:" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>

                                <ComboBox Grid.Column="1"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding CategoryFilterOptions}"
                                          SelectedItem="{Binding CategoryFilter}"
                                          materialDesign:HintAssist.Hint="Категорія"
                                          Style="{StaticResource NeonComboBox}" />

                                <ComboBox Grid.Column="2"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding RiskFilterOptions}"
                                          SelectedItem="{Binding RiskFilter}"
                                          materialDesign:HintAssist.Hint="Ризик"
                                          Style="{StaticResource NeonComboBox}" />

                                <Grid Grid.Column="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Style="{StaticResource NeonTextBox}"
                                             materialDesign:HintAssist.Hint="Пошук за шляхом..."
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource NeonFlatButton}"
                                            Content="Скинути фільтри"
                                            Margin="8,0,0,0"
                                            Command="{Binding ResetFiltersCommand}"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredCandidates}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              MaxHeight="480"
                              Style="{StaticResource NeonDataGrid}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header=""
                                                    IsReadOnly="False"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Шлях" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryLabel}" Width="160" />
                            <DataGridTextColumn Header="Розмір" Binding="{Binding SizeText}" Width="90" />
                            <DataGridTextColumn Header="Останній доступ" Binding="{Binding LastAccessText}" Width="110" />
                            <DataGridTemplateColumn Header="Confidence" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="{Binding Recommendation}">
                                            <ProgressBar Width="72"
                                                         Height="6"
                                                         Maximum="100"
                                                         Value="{Binding Confidence, Mode=OneWay}"
                                                         Foreground="{Binding Confidence, Converter={StaticResource ConfidenceToBrush}}"
                                                         Style="{StaticResource NeonProgressBar}" />
                                            <TextBlock Text="{Binding Confidence, StringFormat={}{0}%}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Рекомендація" Binding="{Binding Recommendation}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ===== CLEANUP RESULT TABLE ===== -->
            <Border Visibility="{Binding CleanupResult, Converter={StaticResource NullToCollapsed}}"
                    Style="{StaticResource NeonCard}"
                    Padding="0"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,12"
                            Background="{DynamicResource BgCardBrush}"
                            CornerRadius="12,12,0,0"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeonCyanBrush}"
                                   Text="Результат очищення"
                                   Effect="{DynamicResource TextGlow}" />
                    </Border>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CleanupResult.Entries}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              MaxHeight="360"
                              Style="{StaticResource NeonDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" />
                            <DataGridTextColumn Header="Шлях" Binding="{Binding Path}" Width="*" />
                            <DataGridTextColumn Header="Розмір" Binding="{Binding Size, Converter={StaticResource BytesToHuman}}" Width="100" />
                            <DataGridTextColumn Header="Деталі" Binding="{Binding Detail}" Width="240" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
