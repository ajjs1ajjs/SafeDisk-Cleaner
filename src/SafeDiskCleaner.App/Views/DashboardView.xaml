<UserControl x:Class="SafeDiskCleaner.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28">

            <!-- ===== WELCOME ===== -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Огляд"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Effect="{StaticResource TextGlow}" />
                <TextBlock Text="Стан дисків і статистика очищення"
                           FontSize="12"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- ===== QUICK ACTIONS ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="Швидкі дії"
                               Style="{StaticResource NeonCardTitle}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource NeonPrimaryButton}"
                                Content="Сканувати зараз"
                                Command="{Binding GoScanNowCommand}" />
                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="Пошук дублікатів"
                                Margin="10,0,0,0"
                                Command="{Binding GoDuplicatesCommand}" />
                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="Карантин"
                                Margin="10,0,0,0"
                                Command="{Binding GoQuarantineCommand}" />
                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="Audit Log"
                                Margin="10,0,0,0"
                                Command="{Binding GoAuditCommand}" />
                        <Button Style="{StaticResource NeonOutlineButton}"
                                Content="Налаштування"
                                Margin="10,0,0,0"
                                Command="{Binding GoSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== STATS CARDS ===== -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource NeonCard}" Margin="0,0,8,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Recycle"
                                                 Width="28" Height="28"
                                                 Foreground="{StaticResource NeonCyanBrush}" />
                        <TextBlock Text="{Binding TotalFreed}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource NeonCyanBrush}" />
                        <TextBlock Text="Звільнено за весь час"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalCleanedEntries, StringFormat={}{0} операцій}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource NeonCard}" Margin="8,0,8,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ShieldLock"
                                                 Width="28" Height="28"
                                                 Foreground="{StaticResource NeonPurpleBrush}" />
                        <TextBlock Text="{Binding QuarantineSize}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="У карантині"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding QuarantineCount, StringFormat={}{0} файлів}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource NeonCard}" Margin="8,0,8,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="MagnifyScan"
                                                 Width="28" Height="28"
                                                 Foreground="{StaticResource NeonBlueBrush}" />
                        <TextBlock Text="{Binding LastScanPotential}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Останнє сканування"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LastScanCandidates, StringFormat={}{0} кандидатів}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource NeonCard}" Margin="8,0,0,16">
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Harddisk"
                                                 Width="28" Height="28"
                                                 Foreground="{StaticResource NeonGreenBrush}" />
                        <TextBlock Text="{Binding Drives.Count, StringFormat={}{0}}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Дисків"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="під аналізом"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Opacity="0.8" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== DRIVES ===== -->
            <Border Style="{StaticResource NeonCard}">
                <StackPanel>
                    <TextBlock Text="Диски"
                               Style="{StaticResource NeonCardTitle}" />
                    <ItemsControl ItemsSource="{Binding Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Letter}"
                                                   FontSize="18" FontWeight="Bold"
                                                   Foreground="{StaticResource NeonCyanBrush}" />
                                        <TextBlock Text="{Binding Kind}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ProgressBar Height="8"
                                                     Maximum="100"
                                                     Value="{Binding UsedPercent}"
                                                     Style="{StaticResource NeonProgressBar}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="160">
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding UsedText}" />
                                            <Run Text=" з " />
                                            <Run Text="{Binding TotalText}" />
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding FreeText, StringFormat=вільно: {0}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>