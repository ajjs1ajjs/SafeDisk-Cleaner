<Window x:Class="SafeDiskCleaner.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SafeDiskCleaner.App.ViewModels"
        xmlns:views="clr-namespace:SafeDiskCleaner.App.Views"
        xmlns:converters="clr-namespace:SafeDiskCleaner.App"
        Title="SafeDisk Cleaner"
        Height="820"
        Width="1280"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        Background="{StaticResource BgDeepBrush}"
        TextElement.Foreground="{StaticResource TextPrimaryBrush}"
        TextElement.FontSize="14"
        FontFamily="{StaticResource NeonFont}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <views:DuplicatesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}">
            <views:QuarantineView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}">
            <views:AuditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialogHost">
        <Grid>
            <!-- Ambient background auras -->
            <Grid x:Name="BgGrid">
                <Rectangle Fill="{StaticResource BgAuraBlue}" />
                <Rectangle Fill="{StaticResource BgAuraPurple}" />
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- HEADER BAR -->
                <Border Grid.Row="0"
                        Padding="24,16,24,14"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{StaticResource BgSurfaceBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldSearch"
                                                     Width="30"
                                                     Height="30"
                                                     Foreground="{StaticResource NeonCyanBrush}"
                                                     Effect="{StaticResource NeonCyanGlow}" />
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="SafeDisk Cleaner"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Effect="{StaticResource TextGlow}" />
                                <TextBlock Text="Безпечний аналіз і очищення дисків Windows"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Opacity="0.8" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Data root indicator -->
                        <Border Grid.Column="2"
                                Padding="12,6"
                                CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Background="{StaticResource BgCardBrush}"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Folder"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,6,0"
                                                         Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Scan.DataRoot}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Window controls -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button x:Name="MinimizeBtn" Width="36" Height="28"
                                    Style="{StaticResource NeonFlatButton}"
                                    Padding="0"
                                    Click="MinimizeBtn_Click">
                                <Path Data="M6,10 L18,10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                            </Button>
                            <Button x:Name="MaximizeBtn" Width="36" Height="28"
                                    Style="{StaticResource NeonFlatButton}"
                                    Padding="0"
                                    Click="MaximizeBtn_Click">
                                <Rectangle Width="10" Height="10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent" />
                            </Button>
                            <Button x:Name="CloseBtn" Width="36" Height="28"
                                    Style="{StaticResource NeonFlatButton}"
                                    Padding="0"
                                    Click="CloseBtn_Click">
                                <Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- UPDATE BANNER -->
                <Border Grid.Row="1"
                        Padding="16,10"
                        Background="#0D1B2E"
                        BorderBrush="{StaticResource NeonBorderGradientBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Update"
                                                     Width="18"
                                                     Height="18"
                                                     Foreground="{StaticResource NeonCyanBrush}"
                                                     Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}">
                                <Run Text="Доступна версія " />
                                <Run Text="{Binding LatestVersionText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource NeonCyanBrush}" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ProgressBar Width="160"
                                         Height="4"
                                         Maximum="100"
                                         Value="{Binding DownloadProgress, Mode=OneWay}"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                         Margin="0,0,12,0" />
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Content="Оновити"
                                    Command="{Binding UpdateCommand}"
                                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InverseBooleanConverter}}"
                                    Foreground="{StaticResource NeonCyanBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN CONTENT AREA -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- NAV SIDEBAR -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BgSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,1,0">
                        <ListBox ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNavItem}"
                                 Style="{StaticResource NeonNavListBox}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                 Width="20"
                                                                 Height="20"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource NeonFont}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- PAGE CONTENT -->
                    <ContentControl Grid.Column="1"
                                    Content="{Binding CurrentPage}"
                                    Margin="0" />
                </Grid>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
