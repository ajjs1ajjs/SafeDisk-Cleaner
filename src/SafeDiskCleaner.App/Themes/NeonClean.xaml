<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ============================================================ -->
    <!-- COLORS -->
    <!-- ============================================================ -->
    <Color x:Key="NeonCyanColor">#00E5FF</Color>
    <Color x:Key="NeonBlueColor">#0070FF</Color>
    <Color x:Key="NeonPurpleColor">#7B2FFF</Color>
    <Color x:Key="NeonRedColor">#FF3B5C</Color>
    <Color x:Key="NeonGreenColor">#34C08A</Color>
    <Color x:Key="BgDeepColor">#0B0E14</Color>
    <Color x:Key="BgSurfaceColor">#111827</Color>
    <Color x:Key="BgCardColor">#161D2E</Color>
    <Color x:Key="BgGlassColor">#1A2332</Color>
    <Color x:Key="TextPrimaryColor">#E6EDF3</Color>
    <Color x:Key="TextSecondaryColor">#8B949E</Color>
    <Color x:Key="BorderColor">#1E2D3D</Color>
    <Color x:Key="NeonBorderCyanColor">#00E5FF</Color>
    <Color x:Key="NeonBorderPurpleColor">#7B2FFF</Color>

    <!-- ============================================================ -->
    <!-- BRUSHES -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}" />
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}" />
    <SolidColorBrush x:Key="NeonPurpleBrush" Color="{StaticResource NeonPurpleColor}" />
    <SolidColorBrush x:Key="NeonRedBrush" Color="{StaticResource NeonRedColor}" />
    <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreenColor}" />
    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgGlassBrush" Color="{StaticResource BgGlassColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="NeonBorderCyanBrush" Color="{StaticResource NeonBorderCyanColor}" />
    <SolidColorBrush x:Key="NeonBorderPurpleBrush" Color="{StaticResource NeonBorderPurpleColor}" />

    <!-- ============================================================ -->
    <!-- BACKGROUND AURA GRADIENT -->
    <!-- ============================================================ -->
    <RadialGradientBrush x:Key="BgAuraBlue" Opacity="0.15" RadiusX="0.6" RadiusY="0.6" Center="0.5,0.2" GradientOrigin="0.5,0.2">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#0070FF" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BgAuraPurple" Opacity="0.12" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.8" GradientOrigin="0.5,0.8">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#7B2FFF" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

    <!-- ============================================================ -->
    <!-- NEON BORDER GRADIENT -->
    <!-- ============================================================ -->
    <LinearGradientBrush x:Key="NeonBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00E5FF" Offset="0" />
        <GradientStop Color="#0070FF" Offset="0.5" />
        <GradientStop Color="#7B2FFF" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ -->
    <!-- GLOW EFFECTS -->
    <!-- ============================================================ -->
    <DropShadowEffect x:Key="NeonCyanGlow" Color="#00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonBlueGlow" Color="#0070FF" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonPurpleGlow" Color="#7B2FFF" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonRedGlow" Color="#FF3B5C" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonCyanGlowStrong" Color="#00E5FF" BlurRadius="20" ShadowDepth="0" Opacity="1.0" />
    <DropShadowEffect x:Key="NeonRedGlowStrong" Color="#FF3B5C" BlurRadius="20" ShadowDepth="0" Opacity="1.0" />
    <DropShadowEffect x:Key="SoftNeonGlow" Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="TextGlow" Color="#00E5FF" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />

    <!-- ============================================================ -->
    <!-- PULSING ANIMATION (for neon borders) -->
    <!-- ============================================================ -->
    <Storyboard x:Key="NeonPulse" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1.0" Duration="0:0:2" AutoReverse="True" />
    </Storyboard>

    <!-- ============================================================ -->
    <!-- TYPOGRAPHY -->
    <!-- ============================================================ -->
    <FontFamily x:Key="NeonFont">Segoe UI, Roboto, Helvetica, Arial, sans-serif</FontFamily>

    <!-- ============================================================ -->
    <!-- MAIN BACKGROUND TEMPLATE (for window root) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonBackground" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgDeepBrush}" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON CARD STYLE (glass panel with neon border) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource BgGlassColor}" Opacity="0.9" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBorderGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect" Value="{StaticResource SoftNeonGlow}" />
    </Style>

    <Style x:Key="NeonCardStatic" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource BgGlassColor}" Opacity="0.9" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBorderGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON PRIMARY BUTTON (cyan glow) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{StaticResource NeonCyanBrush}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource NeonCyanGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource NeonCyanGlowStrong}" />
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#33EAFF" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00B8CC" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource SoftNeonGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.4" />
                            <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON DANGER BUTTON (red glow) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{StaticResource NeonRedBrush}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource NeonRedGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource NeonRedGlowStrong}" />
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF5070" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#CC2040" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource NeonRedGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                            <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON OUTLINE BUTTON -->
    <!-- ============================================================ -->
    <Style x:Key="NeonOutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="Transparent"
                            BorderBrush="{StaticResource NeonCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource SoftNeonGlow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                            <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON FLAT BUTTON (text only, no border) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonFlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.08" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.15" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON DRIVE CARD (for Scan page drive buttons) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonDriveCard" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="driveBorder"
                            Width="110" Height="100"
                            CornerRadius="12"
                            Padding="12"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="#1E2D3D"
                            BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="driveLetter"
                                       Text="{TemplateBinding Content}"
                                       FontSize="28" FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource NeonCyanBrush}" />
                            <TextBlock x:Name="driveKind"
                                       Text="{TemplateBinding Tag}"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="driveBorder" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                            <Setter TargetName="driveBorder" Property="Effect" Value="{StaticResource NeonCyanGlow}" />
                            <Setter TargetName="driveBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#1A2840" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="driveBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#0D1B2E" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON TEXTBOX -->
    <!-- ============================================================ -->
    <Style x:Key="NeonTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                            <Setter TargetName="border" Property="Effect" Value="{StaticResource SoftNeonGlow}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON CHECKBOX -->
    <!-- ============================================================ -->
    <Style x:Key="NeonCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,4,24,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="checkBoxBorder"
                                Width="20" Height="20"
                                CornerRadius="4"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5"
                                Background="{StaticResource BgCardBrush}"
                                Margin="0,0,8,0">
                            <Path x:Name="checkMark"
                                  Data="M2,7 L7,12 L16,2"
                                  Stroke="{StaticResource NeonCyanBrush}"
                                  StrokeThickness="2.5"
                                  Fill="Transparent"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                            <Setter TargetName="checkBoxBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.15" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{StaticResource NeonCyanBrush}" />
                            <Setter TargetName="checkBoxBorder" Property="Effect" Value="{StaticResource SoftNeonGlow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON DATAGRID -->
    <!-- ============================================================ -->
    <Style x:Key="NeonDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource BorderColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource BgCardBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource NeonFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#00E5FF" Opacity="0.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
                    <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON SCROLLVIEWER -->
    <!-- ============================================================ -->
    <Style x:Key="NeonScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON LISTBOX (for nav sidebar) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonNavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="Margin" Value="8,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="navBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="navIndicator"
                                                Width="3"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Margin="0,0,8,0" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#00E5FF" Opacity="0.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="navBorder" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#00E5FF" Opacity="0.1" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="navIndicator" Property="Background" Value="{StaticResource NeonCyanBrush}" />
                                        <Setter TargetName="navIndicator" Property="Effect" Value="{StaticResource NeonCyanGlow}" />
                                        <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON SECTION TITLE -->
    <!-- ============================================================ -->
    <Style x:Key="NeonSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontFamily" Value="{StaticResource NeonFont}" />
    </Style>

    <Style x:Key="NeonCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="Effect" Value="{StaticResource TextGlow}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontFamily" Value="{StaticResource NeonFont}" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON PROGRESSBAR -->
    <!-- ============================================================ -->
    <Style x:Key="NeonProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource BgCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NeonCyanBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Track" CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Effect="{StaticResource NeonCyanGlow}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON INFO BORDER (for info panels) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonInfoBorder" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="#0D1B2E" Opacity="0.8" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBorderGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Effect" Value="{StaticResource SoftNeonGlow}" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON TABLE HEADER (for standalone table headers) -->
    <!-- ============================================================ -->
    <Style x:Key="NeonTableHeader" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{StaticResource BgCardColor}" Opacity="0.95" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource NeonBorderGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10,10,0,0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

</ResourceDictionary>
