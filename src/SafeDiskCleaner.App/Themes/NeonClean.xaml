<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- ============================================================ -->
    <!-- SEMANTIC BRUSHES (fixed, not theme-dependent)                -->
    <!-- Base + accent colors live in Themes/Base and Themes/Accents. -->
    <!-- ============================================================ -->
    <Color x:Key="NeonRedColor">#FF3B5C</Color>
    <Color x:Key="NeonGreenColor">#34C08A</Color>
    <Color x:Key="NeonBlueColor">#3AA2FF</Color>
    <Color x:Key="NeonPurpleColor">#7B2FFF</Color>

    <SolidColorBrush x:Key="NeonRedBrush" Color="{StaticResource NeonRedColor}" />
    <SolidColorBrush x:Key="NeonGreenBrush" Color="{StaticResource NeonGreenColor}" />
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}" />
    <SolidColorBrush x:Key="NeonPurpleBrush" Color="{StaticResource NeonPurpleColor}" />

    <DropShadowEffect x:Key="NeonRedGlow" Color="#FF3B5C" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonRedGlowStrong" Color="#FF3B5C" BlurRadius="20" ShadowDepth="0" Opacity="1.0" />

    <!-- ============================================================ -->
    <!-- TYPOGRAPHY                                                    -->
    <!-- ============================================================ -->
    <FontFamily x:Key="NeonFont">Segoe UI Variable, Segoe UI, Roboto, Helvetica, Arial, sans-serif</FontFamily>

    <!-- ============================================================ -->
    <!-- NEON CARD STYLE (glass panel with accent gradient border)     -->
    <!-- ============================================================ -->
    <Style x:Key="NeonCard" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource BgGlassColor}" Opacity="0.9" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource NeonBorderGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Effect" Value="{DynamicResource SoftNeonGlow}" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON PRIMARY BUTTON (accent glow)                             -->
    <!-- ============================================================ -->
    <Style x:Key="NeonPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{DynamicResource NeonCyanBrush}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource NeonCyanGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Effect" Value="{DynamicResource NeonCyanGlowStrong}" />
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanHoverColor}" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanPressedColor}" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="btnBorder" Property="Effect" Value="{DynamicResource SoftNeonGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.4" />
                            <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON DANGER BUTTON (red glow)                                 -->
    <!-- ============================================================ -->
    <Style x:Key="NeonDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="{StaticResource NeonRedBrush}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource NeonRedGlow}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource NeonRedGlowStrong}" />
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#FF5070" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#CC2040" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="btnBorder" Property="Effect" Value="{StaticResource NeonRedGlow}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                            <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON OUTLINE BUTTON                                           -->
    <!-- ============================================================ -->
    <Style x:Key="NeonOutlineButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="Transparent"
                            BorderBrush="{DynamicResource NeonCyanBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.1" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="btnBorder" Property="Effect" Value="{DynamicResource SoftNeonGlow}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                            <Setter TargetName="btnBorder" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON FLAT BUTTON (text only, no border)                       -->
    <!-- ============================================================ -->
    <Style x:Key="NeonFlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="btnBorder"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.08" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="btnBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.15" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="btnBorder" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON TEXTBOX                                                  -->
    <!-- ============================================================ -->
    <Style x:Key="NeonTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="{DynamicResource NeonCyanBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
                            <Setter TargetName="border" Property="Effect" Value="{DynamicResource SoftNeonGlow}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.5" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON TOGGLE SWITCH                                           -->
    <!-- ============================================================ -->
    <Style x:Key="NeonToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="track"
                                Width="64" Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource BgCardBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="knob"
                                         Width="20" Height="20"
                                         HorizontalAlignment="Left"
                                         Margin="4,0,0,0"
                                         Fill="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
                            <Setter TargetName="track" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.25" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource NeonCyanBrush}" />
                            <Setter TargetName="knob" Property="Effect" Value="{DynamicResource NeonCyanGlow}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON COMBOBOX (based on the MaterialDesign implicit style)    -->
    <!-- ============================================================ -->
    <Style x:Key="NeonComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON CHECKBOX                                                 -->
    <!-- ============================================================ -->
    <Style x:Key="NeonCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="0,4,24,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="checkBoxBorder"
                                Width="20" Height="20"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1.5"
                                Background="{DynamicResource BgCardBrush}"
                                Margin="0,0,8,0">
                            <Path x:Name="checkMark"
                                  Data="M2,7 L7,12 L16,2"
                                  Stroke="{DynamicResource NeonCyanBrush}"
                                  StrokeThickness="2.5"
                                  Fill="Transparent"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
                            <Setter TargetName="checkBoxBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.15" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
                            <Setter TargetName="checkBoxBorder" Property="Effect" Value="{DynamicResource SoftNeonGlow}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON DATAGRID                                                 -->
    <!-- ============================================================ -->
    <Style x:Key="NeonDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource NeonFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}" />
                    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON LISTBOX (for nav sidebar)                                -->
    <!-- ============================================================ -->
    <Style x:Key="NeonNavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="16,12" />
                    <Setter Property="Margin" Value="8,2" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="navBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}"
                                        Margin="{TemplateBinding Margin}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="navIndicator"
                                                Width="3"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                Background="Transparent"
                                                Margin="0,0,8,0" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="navBorder" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.06" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="navBorder" Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{DynamicResource NeonCyanColor}" Opacity="0.1" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="navIndicator" Property="Background" Value="{DynamicResource NeonCyanBrush}" />
                                        <Setter TargetName="navIndicator" Property="Effect" Value="{DynamicResource NeonCyanGlow}" />
                                        <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON CARD TITLE                                               -->
    <!-- ============================================================ -->
    <Style x:Key="NeonCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}" />
        <Setter Property="Effect" Value="{DynamicResource TextGlow}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="FontFamily" Value="{StaticResource NeonFont}" />
    </Style>

    <!-- ============================================================ -->
    <!-- NEON PROGRESSBAR                                              -->
    <!-- ============================================================ -->
    <Style x:Key="NeonProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource NeonCyanBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Track" CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Effect="{DynamicResource NeonCyanGlow}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- NEON INFO BORDER (for info panels)                            -->
    <!-- ============================================================ -->
    <Style x:Key="NeonInfoBorder" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource BgGlassColor}" Opacity="0.8" />
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource NeonBorderGradientBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Effect" Value="{DynamicResource SoftNeonGlow}" />
    </Style>

</ResourceDictionary>