<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent preset: Green. Swapped at runtime by ThemeService. -->

    <Color x:Key="NeonCyanColor">#22C55E</Color>
    <Color x:Key="NeonCyanHoverColor">#4ADE80</Color>
    <Color x:Key="NeonCyanPressedColor">#16A34A</Color>

    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}" />

    <DropShadowEffect x:Key="NeonCyanGlow" Color="#22C55E" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonCyanGlowStrong" Color="#22C55E" BlurRadius="20" ShadowDepth="0" Opacity="1.0" />
    <DropShadowEffect x:Key="SoftNeonGlow" Color="#22C55E" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="TextGlow" Color="#22C55E" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />

    <LinearGradientBrush x:Key="NeonBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22C55E" Offset="0" />
        <GradientStop Color="#16A34A" Offset="0.5" />
        <GradientStop Color="#0E7490" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>