<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accent preset: Purple. Swapped at runtime by ThemeService. -->

    <Color x:Key="NeonCyanColor">#A855F7</Color>
    <Color x:Key="NeonCyanHoverColor">#B96AFA</Color>
    <Color x:Key="NeonCyanPressedColor">#9333EA</Color>

    <SolidColorBrush x:Key="NeonCyanBrush" Color="{StaticResource NeonCyanColor}" />

    <DropShadowEffect x:Key="NeonCyanGlow" Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
    <DropShadowEffect x:Key="NeonCyanGlowStrong" Color="#A855F7" BlurRadius="20" ShadowDepth="0" Opacity="1.0" />
    <DropShadowEffect x:Key="SoftNeonGlow" Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.5" />
    <DropShadowEffect x:Key="TextGlow" Color="#A855F7" BlurRadius="4" ShadowDepth="0" Opacity="0.6" />

    <LinearGradientBrush x:Key="NeonBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A855F7" Offset="0" />
        <GradientStop Color="#7B2FFF" Offset="0.5" />
        <GradientStop Color="#4C1D95" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>