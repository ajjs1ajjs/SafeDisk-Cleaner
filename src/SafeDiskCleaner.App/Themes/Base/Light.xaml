<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light base palette — swapped at runtime by ThemeService. -->

    <Color x:Key="BgDeepColor">#E9EEF5</Color>
    <Color x:Key="BgSurfaceColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#F3F6FB</Color>
    <Color x:Key="BgGlassColor">#FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#0F1B2D</Color>
    <Color x:Key="TextSecondaryColor">#5A6B80</Color>
    <Color x:Key="BorderColor">#D4DEEA</Color>

    <SolidColorBrush x:Key="BgDeepBrush" Color="{StaticResource BgDeepColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgGlassBrush" Color="{StaticResource BgGlassColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <RadialGradientBrush x:Key="BgAuraBlue" Opacity="0.10" RadiusX="0.6" RadiusY="0.6" Center="0.5,0.2" GradientOrigin="0.5,0.2">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#0070FF" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BgAuraPurple" Opacity="0.08" RadiusX="0.5" RadiusY="0.5" Center="0.5,0.8" GradientOrigin="0.5,0.8">
        <RadialGradientBrush.GradientStops>
            <GradientStop Color="#7B2FFF" Offset="0" />
            <GradientStop Color="Transparent" Offset="1" />
        </RadialGradientBrush.GradientStops>
    </RadialGradientBrush>

</ResourceDictionary>